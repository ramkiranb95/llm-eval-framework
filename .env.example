# LLM Evaluation Framework — Environment Variables
# Copy this file to .env and fill in your keys.
#
#   cp .env.example .env
#
# The SUT (Ollama/mistral) runs locally and needs no API key.
# The Judge LLM evaluates SUT output — pick one provider below.

# ── Option A: Groq (recommended — free tier, 30 RPM / 1000 req/day) ──────────
# Get your key at: https://console.groq.com
# Set judge_provider: "groq" in config/config.yaml
GROQ_API_KEY=your_groq_api_key_here

# ── Option B: Gemini (requires billing-enabled Google account) ────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# Set judge_provider: "gemini" in config/config.yaml
GEMINI_API_KEY=your_gemini_api_key_here

# ── Option C: Ollama (no key needed — slow, local, no quota) ─────────────────
# Set judge_provider: "ollama" in config/config.yaml
# No entry needed here.
